#!/usr/bin/env amber
// 2> /dev/null; exit 1

import { file_read, file_write } from "std/fs"
import { match_regex, parse_int, replace_regex, split } from "std/text"

const manifest = "xx.yml"

fun die(message: Text) {
    trust $ printf '%s\n' "{message}" >&2 $
    fail 1
}

fun command_output(command: Text): Text? {
    const output = $ bash -c "{command}" $ failed {
        die("Command failed: {command}")?
    }
    return output
}

fun ensure_clean_worktree() {
    const changes = command_output("git status --porcelain")?
    if changes != "" {
        $ git status --short >&2 $ failed {
            die("Failed to show git status")?
        }
        die("Refusing to mark a release with uncommitted changes.")?
    }
}

fun read_manifest_version(): Text? {
    const content = file_read(manifest)?
    const version = replace_regex(content, "^version: \\\"([^\\\"]+)\\\"[[:space:]]*$", "\\1", true)
    if version == content {
        die("Failed to read version from {manifest}")?
    }
    return version
}

fun latest_release_version(): Text? {
    const latest_tag = command_output("git tag --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | head -n1")?
    if latest_tag == "" {
        return "0.0.0"
    }
    return replace_regex(latest_tag, "^v", "", true)
}

fun version_core(version: Text): Text? {
    const core = replace_regex(version, "-.*$", "", true)
    if match_regex(core, "^[0-9]+\\.[0-9]+\\.[0-9]+$", true) == false {
        die("Version '{version}' is not a plain semver version.")?
    }
    return core
}

fun parse_version_core(version: Text): [Int]? {
    const core = version_core(version)?
    const parts = split(core, ".")
    return [parse_int(parts[0])?, parse_int(parts[1])?, parse_int(parts[2])?]
}

fun tag_exists(tag: Text): Bool {
    silent trust $ git rev-parse -q --verify refs/tags/{tag} $
    return status() == 0
}

fun choose_version_source(choice: Text, manifest_version: Text, tag_version: Text): Text? {
    if {
        choice == "m" {
            return manifest_version
        }
        choice == "manifest" {
            return manifest_version
        }
        choice == "t" {
            return tag_version
        }
        choice == "tag" {
            return tag_version
        }
        else {
            die("Unknown choice '{choice}'. Use m or t.")?
        }
    }
}

fun choose_version(choice: Text, patch_version: Text, minor_version: Text, major_version: Text): Text? {
    if {
        choice == "p" {
            return patch_version
        }
        choice == "patch" {
            return patch_version
        }
        choice == "m" {
            return minor_version
        }
        choice == "minor" {
            return minor_version
        }
        choice == "r" {
            return major_version
        }
        choice == "major" {
            return major_version
        }
        else {
            die("Unknown choice '{choice}'. Use p, m, or r.")?
        }
    }
}

fun prompt(message: Text): Text? {
    return $ printf '%s' "{message}" >&2; read -r value; export value; printenv value $ failed {
        die("Failed to read input")?
    }
}

fun choose_bump_source(current_version: Text, latest_version: Text): Text? {
    const current_version_core = version_core(current_version)?

    if current_version_core != latest_version {
        echo("Manifest version:     {current_version}")
        echo("Latest tag version:   {latest_version}")
        echo("")
        const source_choice = prompt("Choose version source to bump [(m)anifest/(t)ag]: ")?
        const source_version = choose_version_source(source_choice, current_version_core, latest_version)?
        echo("")
        return source_version
    } else {
        return latest_version
    }
}

main {
    ensure_clean_worktree()?

    const current_version = read_manifest_version()?
    const latest_version = latest_release_version()?
    const source_version = choose_bump_source(current_version, latest_version)?

    const version_parts = parse_version_core(source_version)?

    const major = version_parts[0]
    const minor = version_parts[1]
    const patch = version_parts[2]

    const patch_version = "{major}.{minor}.{patch + 1}"
    const minor_version = "{major}.{minor + 1}.0"
    const major_version = "{major + 1}.0.0"

    echo("Current manifest version: {current_version}")
    echo("Latest release version:   {latest_version}")
    echo("Bumping from version:     {source_version}")
    echo("")
    echo("Suggested next versions:")
    echo("  (p)atch: {patch_version}")
    echo("  (m)inor: {minor_version}")
    echo("  majo(r): {major_version}")

    const choice = prompt("Choose release semver increment [(p)atch/(m)inor/majo(r)]: ")?
    const new_version = choose_version(choice, patch_version, minor_version, major_version)?

    const release_parts = parse_version_core(new_version)?
    const release_major = release_parts[0]
    const release_minor = release_parts[1]
    const release_patch = release_parts[2]

    const snapshot_patch_version = "{release_major}.{release_minor}.{release_patch + 1}-snapshot"
    const snapshot_minor_version = "{release_major}.{release_minor + 1}.0-snapshot"
    const snapshot_major_version = "{release_major + 1}.0.0-snapshot"

    echo("")
    echo("Suggested next snapshots:")
    echo("  (p)atch: {snapshot_patch_version}")
    echo("  (m)inor: {snapshot_minor_version}")
    echo("  majo(r): {snapshot_major_version}")

    const snapshot_choice = prompt("Choose next snapshot semver increment [(p)atch/(m)inor/majo(r)]: ")?
    const next_snapshot = choose_version(snapshot_choice, snapshot_patch_version, snapshot_minor_version, snapshot_major_version)?

    const new_tag = "v{new_version}"
    if tag_exists(new_tag) {
        die("Tag {new_tag} already exists.")?
    }

    const expected_snapshot = "{new_version}-snapshot"
    if current_version != expected_snapshot {
        if current_version != new_version {
            const continue_choice = prompt("Manifest version is '{current_version}', not '{expected_snapshot}'. Continue? [y/N]: ")?
            if {
                continue_choice == "y" {
                    echo("Continuing.")
                }
                continue_choice == "Y" {
                    echo("Continuing.")
                }
                continue_choice == "yes" {
                    echo("Continuing.")
                }
                continue_choice == "YES" {
                    echo("Continuing.")
                }
                else {
                    echo("Aborted.")
                    fail 1
                }
            }
        }
    }

    file_write(manifest, "version: \"{new_version}\"\n")?
    $ git add {manifest} $?
    $ git commit -m "chore: release {new_version}" $?
    $ git tag --no-sign {new_tag} $?

    file_write(manifest, "version: \"{next_snapshot}\"\n")?
    $ git add {manifest} $?
    $ git commit -m "chore: start {next_snapshot}" $?

    echo("")
    echo("Marked release {new_version}.")
    echo("Created commit: chore: release {new_version}")
    echo("Created tag:    {new_tag}")
    echo("Created commit: chore: start {next_snapshot}")
    echo("")
    echo("Push with:")
    echo("  git push origin HEAD {new_tag}")
}
